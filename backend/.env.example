# Environment & App Settings
ENVIRONMENT=development
PROJECT_NAME="MechanicMate API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000"]

# Neon PostgreSQL Database URL (pooled asyncpg driver)
DATABASE_URL=postgresql+asyncpg://username:password@ep-project-pooler.neon.tech/neondb?ssl=require

# Clerk Multi-Tenant Authentication
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Trigger.dev Background Orchestration
TRIGGER_SECRET_KEY=tr_dev_your_secret_key
TRIGGER_API_URL=https://api.trigger.dev
